        <mxCell id="b4" value="B4 单一真相同步&#10;引脚 / 时钟 / 行为 / 状态 各自只在一处定义（见 N3）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1">
