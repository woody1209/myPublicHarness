        <mxCell id="b3" value="B3 代码落点分层&#10;纯逻辑进 source/（主机可测）；硬件隔离 _hw.c / board_*.c（见 N2）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1">
