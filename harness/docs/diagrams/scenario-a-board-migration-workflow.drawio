        </mxCell>
        <mxCell id="a7" value="A7 知识落盘&#10;targets 回填 / docs 踩坑 / ADR / README / state.json / memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1">
