        <mxCell id="a2" value="A2 环境自发现&#10;doctor.ps1 &#8594; manifest.json（工具链/SDK/探针唯一出处，禁止猜路径）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="170" y="284" width="340" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="A3 建目标卡 targets/&lt;MPN&gt;.json&#10;两阶段：手册可查先填；字地址/启动顺序上板实证后回填并注明来源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="170" y="368" width="340" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="a4" value="A4 换板必查清单（11 条硬件事实）&#10;逐条实证后才许写进代码 &#8594; 见右侧 N1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="170" y="452" width="340" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="a5" value="A5 移植参考工程&#10;Makefile 保留项 + 分层 + board_pins.h + 启动顺序样板" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="170" y="536" width="340" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="a6" value="A6 验证闭环（聚合门）&#10;verify.ps1 -Hil &#8594; VERIFY OK（9 腿全 PASS）&#10;&#8594; 见右侧 N2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1">
