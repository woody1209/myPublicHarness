        </mxCell>
        <mxCell id="lega" value="图例：实线 = 主流程；虚线 = 参考挂接&#10;黄菱形 = 判定；绿框 = 分支 / 终点；灰框 = 右侧注释卡" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;align=center;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
